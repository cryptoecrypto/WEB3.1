  "dailyMessages": [
    {
      "phrase": "A harmonia nasce quando cada função respeita a outra.",
      "idea": "Transforme uma área do site em uma experiência guiada de três passos.",
      "tip": "Antes de editar, registre o caminho, a versão e o objetivo do arquivo."
    },
    {
      "phrase": "NEXUS conecta; Sensei conduz.",
      "idea": "Crie um cartão que explique como uma das 13 áreas se conecta às outras.",
      "tip": "Teste a página em tela pequena e grande antes de publicar."
    },
    {
      "phrase": "Preservar é permitir que o futuro continue.",
      "idea": "Adicione uma linha do tempo visual a uma página histórica.",
      "tip": "Nunca edite a HD MATRIZ como se fosse uma pasta de rascunhos."
    },
    {
      "phrase": "Uma boa interface ensina antes mesmo de alguém perguntar.",
      "idea": "Converta um texto longo em cartões com títulos, exemplos e próximos passos.",
      "tip": "Mantenha contraste forte e fontes legíveis; animação não deve atrapalhar leitura."
    },
    {
      "phrase": "Criatividade com método vira construção.",
      "idea": "Experimente uma capa sazonal sem mudar a estrutura ou os endereços da página.",
      "tip": "Prefira variáveis CSS compartilhadas a copiar estilos em dezenas de HTMLs."
    },
    {
      "phrase": "O detalhe também merece auditoria.",
      "idea": "Inclua uma pequena seção 'O que mudou hoje' com data e versão.",
      "tip": "Confirme os links internos e a navegação por teclado."
    },
    {
      "phrase": "Cor é linguagem; equilíbrio é arquitetura.",
      "idea": "Use uma cor de destaque por função e mantenha o restante da paleta em equilíbrio.",
      "tip": "Evite depender apenas da cor para transmitir estados: use texto e ícones."
    },
    {
      "phrase": "Não confunda movimento com progresso.",
      "idea": "Crie uma demonstração interativa que permita comparar duas versões de um recurso.",
      "tip": "Respeite prefers-reduced-motion e não use animações excessivas."
    },
    {
      "phrase": "O conhecimento fica mais forte quando tem fonte.",
      "idea": "Transforme uma pergunta recorrente em um mini-guia com exemplos reais.",
      "tip": "Toda afirmação técnica deve indicar se é documentada, testada ou apenas planejada."
    },
    {
      "phrase": "Primeiro proteger. Depois aprimorar. Por fim, publicar.",
      "idea": "Crie uma prévia visual antes de substituir qualquer conteúdo público.",
      "tip": "Faça backup verificável antes de alterações amplas."
    },
    {
      "phrase": "Pequenas melhorias diárias constroem grandes sistemas.",
      "idea": "Melhore uma única interação por dia e registre o resultado.",
      "tip": "Não remova funcionalidades existentes para simplificar uma página sem autorização."
    },
    {
      "phrase": "O futuro é construído com evidências no presente.",
      "idea": "Mostre o estado de cada módulo: planejado, implementado, testado ou aprovado.",
      "tip": "Nunca declare sincronização ou homologação sem evidência reproduzível."
    }
  ],
  "governance": {
    "visualOnly": true,
    "dailyChange": "A paleta, o acabamento dos cartões e o espaçamento visual mudam uma vez por dia, às 00:00 no fuso America/Sao_Paulo.",
    "informationInvariant": "Não alterar textos, dados, destinos, ordem semântica, formulários, arquivos ou conteúdo editorial durante a rotação visual.",
    "selection": "Determinística por data de São Paulo: todos os visitantes recebem o mesmo conjunto visual no mesmo dia, sem alternar a cada recarga.",
    "clockSource": "Relógio do dispositivo; não é uma confirmação de horário por servidor.",
    "fallback": "Se a configuração não carregar, aplicar a paleta segura de fallback sem bloquear a página.",
    "accessibility": "Respeitar prefers-reduced-motion, foco visível, leitura em telas pequenas e contraste adequado."
  },
