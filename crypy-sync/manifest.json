{
  "version": "1.0.0",
  "repository": "cryptoecrypto/WEB3.1",
  "role": "public-client",
  "authority": "HD-MATRIZ",
  "description": "Cliente público do ecossistema CRYPY. HD-MATRIZ é a autoridade privada; este repositório mantém apenas site, índices públicos, interface e integração mínima online.",
  "repositories": [
    {
      "name": "cryptoecrypto/WEB3.1",
      "role": "public-client"
    },
    {
      "name": "cryptoecrypto/HD-MATRIZ",
      "role": "private-core"
    },
    {
      "name": "cryptoecrypto/SECURYTY-SUBC",
      "role": "security-controls"
    }
  ],
  "policy": {
    "directPushToMain": false,
    "promotion": "pull-request-only",
    "conflictResolution": "manual-review-required",
    "allowed": [
      "assets/data/crypy-page-index.json",
      "assets/js/crypy-global-nav.js",
      "assets/js/baby-global-chat.js",
      "baby-server-bridge.js",
      "crypy-sync/**",
      ".github/workflows/crypy-three-repo.yml"
    ],
    "denied": [
      ".env*",
      "**/.baby/**",
      "**/data/**",
      "**/evidence/**",
      "**/snapshots/**",
      "**/sessions/**",
      "**/*token*",
      "**/*secret*",
      "**/Memorias.json",
      "**/memory*.json",
      "**/Fila-Sync.json",
      "**/Manifest.json",
      "**/backup*",
      "**/memory-boost/**",
      "**/momory-boost/**",
      "**/baby-ia/**",
      "**/hd-oculto/**",
      "**/hd-matriz/**",
      "**/pluguin/**",
      "**/sincronizacao/**",
      "CRYPY-13-CHATBOOTS/**",
      "crypy-server-bridge/**",
      "**/hd-baby-ia.html",
      "**/hd-memory.html",
      "**/auto-config*",
      "**/autoconfig*",
      "**/profile.json"
    ],
    "privateDataReplication": false,
    "destructiveSync": false
  },
  "automation": {
    "requiredSecret": "CRYPY_SYNC_TOKEN",
    "status": "blocked-until-secret-provisioned",
    "permissions": [
      "contents:read/write",
      "pull-requests:read/write"
    ]
  },
  "apiContract": {
    "scheme": "Bearer",
    "header": "Authorization",
    "prefix": "Bearer",
    "minimumTokenBytes": 32,
    "originsEnv": "CRYPY_ALLOWED_ORIGINS",
    "originPolicy": "exact-match-no-wildcard",
    "clientStorage": "sessionStorage"
  },
  "branch": "feat/crypy-three-repo-sync-v1"
}
