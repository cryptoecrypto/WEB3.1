# Railway / server-side secrets. Never commit real values.
NODE_ENV=production
PORT=8080
CRYPY_DROPBOX_BRIDGE_TOKEN=
CRYPY_DROPBOX_ALLOWED_ORIGINS=https://cryptoecrypto.github.io
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://YOUR-BRIDGE.up.railway.app/oauth/dropbox/callback
DROPBOX_TOKEN_ENCRYPTION_KEY=
DROPBOX_DATA_DIR=/data/crypy-dropbox
DROPBOX_SCOPES=files.metadata.read files.content.write
