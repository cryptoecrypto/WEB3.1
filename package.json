    "snapshot": "node bin/baby.js snapshot",
    "verify": "node bin/baby.js verify",
    "review": "node bin/baby.js review",
    "evidence": "node bin/baby.js evidence",
    "terminal": "node src/terminal.js",
    "audit": "node scripts/audit.js",
    "inventory": "node src/terminal.js --inventory"
  },
  "dependencies": {}
}
