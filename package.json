{
  "name": "crypy-server-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "CRYPY / BABY — núcleo operacional: memória, centralização, autonomia controlada, autoproteção e evolução contínua. MODO REAL.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
