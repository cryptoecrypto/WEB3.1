# Backend CRYPY Academy — configure somente no provedor de hospedagem.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# URL pública do backend e origem exata do GitHub Pages.
API_BASE_URL=https://SEU-SERVICO.up.railway.app
APP_ORIGIN=https://cryptoecrypto.github.io
FRONTEND_URL=https://cryptoecrypto.github.io/WEB3.1/crypy-academy/cursos.html

# OAuth OIDC — cadastre os callbacks abaixo nos dois provedores.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Sessões e certificados.
SESSION_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_BYTES_OU_MAIS
CERTIFICATE_ISSUER=CRYPY ACADEMY · WEB3.1 / CryptoëCrypto
CERTIFICATE_PUBLIC_URL=https://SEU-SERVICO.up.railway.app/api/verify

# SMTP (ex.: provedor transacional). Sem SMTP, diploma fica emitido mas e-mail pendente.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRYPY Academy <diplomas@SEU-DOMINIO>

# Opcional: token de autenticação do webhook Hotmart; não habilita acesso PHD por si só.
HOTMART_WEBHOOK_TOKEN=
